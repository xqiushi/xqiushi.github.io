                      "file_text": "const fs = require('fs');\nconst path = require('path');\nconst { JSDOM } = require('jsdom');\n\n// HTML to Markdown conversion functions\nfunction htmlToMarkdown(html) {\n  const dom = new JSDOM(html);\n  const document = dom.window.document;\n  \n  return convertElement(document.body);\n}\n\nfunction convertElement(element) {\n  if (!element) return '';\n  \n  let result = '';\n  \n  for (const node of element.childNodes) {\n    if (node.nodeType === 3) { // Text node\n      result += node.textContent;\n    } else if (node.nodeType === 1) { // Element node\n      result += convertElementToMarkdown(node);\n    }\n  }\n  \n  return result;\n}\n\nfunction convertElementToMarkdown(element) {\n  const tagName = element.tagName.toLowerCase();\n  const content = convertElement(element);\n  \n  switch (tagName) {\n    case 'h1': return `# ${content}\\n\\n`;\n    case 'h2': return `## ${content}\\n\\n`;\n    case 'h3': return `### ${content}\\n\\n`;\n    case 'h4': return `#### ${content}\\n\\n`;\n    case 'h5': return `##### ${content}\\n\\n`;\n    case 'h6': return `###### ${content}\\n\\n`;\n    case 'p': return `${content}\\n\\n`;\n    case 'br': return '\\n';\n    case 'strong': case 'b': return `**${content}**`;\n    case 'em': case 'i': return `*${content}*`;\n    case 'code': return `\\`${content}\\``;\n    case 'pre': return `\\`\\`\\`\\n${content}\\n\\`\\`\\`\\n\\n`;\n    case 'blockquote': return `> ${content}\\n\\n`;\n    case 'ul': return `${content}\\n`;\n    case 'ol': return `${content}\\n`;\n    case 'li': return `- ${content}\\n`;\n    case 'a': \n      const href = element.getAttribute('href');\n      return href ? `[${content}](${href})` : content;\n    case 'img':\n      const src = element.getAttribute('src');\n      const alt = element.getAttribute('alt') || '';\n      return src ? `![${alt}](${src})\\n\\n` : '';\n    case 'hr': return '---\\n\\n';\n    default: return content;\n  }\n}\n\n// Extract metadata from HTML\nfunction extractMetadata(htmlContent, filePath) {\n  const dom = new JSDOM(htmlContent);\n  const document = dom.window.document;\n  \n  const title = document.querySelector('title')?.textContent?.replace(' | Reddy.Wang', '') || '';\n  const description = document.querySelector('meta[name=\"description\"]')?.getAttribute('content') || '';\n  \n  // Extract date from file path\n  const pathParts = filePath.split('/');\n  const yearIndex = pathParts.findIndex(part => /^\\d{4}$/.test(part));\n  let date = '';\n  if (yearIndex >= 0 && pathParts[yearIndex + 1] && pathParts[yearIndex + 2]) {\n    const year = pathParts[yearIndex];\n    const month = pathParts[yearIndex + 1].padStart(2, '0');\n    const day = pathParts[yearIndex + 2].padStart(2, '0');\n    date = `${year}-${month}-${day}`;\n  }\n  \n  // Extract slug from path\n  const slug = pathParts[pathParts.length - 2] || '';\n  \n  return { title, description, date, slug };\n}\n\n// Extract post content from HTML\nfunction extractPostContent(htmlContent) {\n  const dom = new JSDOM(htmlContent);\n  const document = dom.window.document;\n  \n  const postContainer = document.querySelector('.post-container');\n  if (!postContainer) return '';\n  \n  // Remove navigation elements\n  const pager = postContainer.querySelector('.pager');\n  if (pager) pager.remove();\n  \n  const hr = postContainer.querySelector('hr');\n  if (hr) hr.remove();\n  \n  return postContainer.innerHTML;\n}\n\n// Find all HTML files recursively\nfunction findHtmlFiles(dir) {\n  const files = [];\n  \n  function traverse(currentDir) {\n    const entries = fs.readdirSync(currentDir, { withFileTypes: true });\n    \n    for (const entry of entries) {\n      const fullPath = path.join(currentDir, entry.name);\n      \n      if (entry.isDirectory()) {\n        traverse(fullPath);\n      } else if (entry.isFile() && entry.name === 'index.html') {\n        // Skip main pages\n        if (!fullPath.includes('/2007/') && \n            !fullPath.includes('/2010/') && \n            !fullPath.includes('/2011/') && \n            !fullPath.includes('/2014/') && \n            !fullPath.includes('/2015/') && \n            !fullPath.includes('/2016/') && \n            !fullPath.includes('/2017/') && \n            !fullPath.includes('/2018/')) {\n          continue;\n        }\n        files.push(fullPath);\n      }\n    }\n  }\n  \n  traverse(dir);\n  return files;\n}\n\n// Convert single HTML file to Markdown\nfunction convertHtmlFile(htmlFilePath, outputDir) {\n  try {\n    const htmlContent = fs.readFileSync(htmlFilePath, 'utf-8');\n    const metadata = extractMetadata(htmlContent, htmlFilePath);\n    const postContent = extractPostContent(htmlContent);\n    \n    if (!postContent) {\n      console.log(`No post content found in: ${htmlFilePath}`);\n      return;\n    }\n    \n    const markdownContent = htmlToMarkdown(postContent);\n    \n    // Create frontmatter\n    const frontmatter = `---\ntitle: \"${metadata.title}\"\ndate: \"${metadata.date}\"\nslug: \"${metadata.slug}\"\ndescription: \"${metadata.description}\"\n---\n\n`;\n    \n    const fullMarkdown = frontmatter + markdownContent;\n    \n    // Create output filename\n    const outputFileName = `${metadata.slug}.md`;\n    const outputPath = path.join(outputDir, outputFileName);\n    \n    fs.writeFileSync(outputPath, fullMarkdown, 'utf-8');\n    console.log(`Converted: ${htmlFilePath} -> ${outputPath}`);\n    \n  } catch (error) {\n    console.error(`Error converting ${htmlFilePath}:`, error.message);\n  }\n}\n\n// Main conversion function\nfunction convertAllHtmlFiles() {\n  const sourceDir = '/Users/x/xqiushi.github.io';\n  const outputDir = '/Users/x/blog/posts';\n  \n  // Ensure output directory exists\n  if (!fs.existsSync(outputDir)) {\n    fs.mkdirSync(outputDir, { recursive: true });\n  }\n  \n  const htmlFiles = findHtmlFiles(sourceDir);\n  console.log(`Found ${htmlFiles.length} HTML files to convert`);\n  \n  for (const htmlFile of htmlFiles) {\n 